# Copy to ~/.config/squiggle-feedback-api/env and `chmod 600` it.

# Shared secret the app sends as `Authorization: Bearer ...`.
# Generate with: openssl rand -hex 32
FEEDBACK_API_TOKEN=

# Fine-grained PAT scoped to the repo below with only "Issues: Read and write".
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=Ymit24/squiggle

# Optional
# FEEDBACK_BIND=127.0.0.1:8787
# FEEDBACK_LABEL=app-submission
# RUST_LOG=info
