  "fixed_sql": [
    {
      "name": "document_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_metadata\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"preview_png\" BLOB NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "document_bodies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_bodies\" (\"document_id\" TEXT NOT NULL REFERENCES document_metadata (id) ON DELETE CASCADE, \"format_version\" INTEGER NOT NULL, \"body\" TEXT NOT NULL, PRIMARY KEY (\"document_id\"));"
        }
      ]
    },
    {
      "name": "images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"images\" (\"hash\" TEXT NOT NULL, \"bytes\" BLOB NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"hash\"));"
        }
      ]
    },
    {
      "name": "image_refs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_refs\" (\"document_id\" TEXT NOT NULL REFERENCES document_metadata (id) ON DELETE CASCADE, \"image_hash\" TEXT NOT NULL REFERENCES images (hash), PRIMARY KEY (\"document_id\", \"image_hash\"));"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
